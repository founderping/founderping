# Copy to publish.env, which is gitignored, and fill in; publish.sh reads it.
# Wrap any value containing spaces or `$` in single quotes.

# A Central Portal user token, not your login: sign in at
# https://central.sonatype.com with the account that verified the
# app.founderping namespace, then Account → Generate User Token.
MAVEN_CENTRAL_USERNAME=
MAVEN_CENTRAL_PASSWORD=

# Passphrase of the signing key. The key itself goes in signing-key.asc next to
# this file, gitignored as well:
#   gpg --armor --export-secret-keys KEY_ID > signing-key.asc
# Central checks every signature against the public key on a keyserver, so
# publish that once:
#   gpg --keyserver keyserver.ubuntu.com --send-keys KEY_ID
SIGNING_KEY_PASSWORD=
