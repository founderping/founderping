<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Chromium refuses getUserMedia unless both this and RECORD_AUDIO are
      present, and the only clue is a cr_media line. A normal permission, so it
      is declared here; strip it with tools:node="remove" and voice input stops.
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Not declared: voice input is opt-in by the host declaring RECORD_AUDIO. -->

    <application>
        <!-- Starts the library with the app; see StartupProvider. -->
        <provider
            android:name="app.founderping.widget.StartupProvider"
            android:authorities="${applicationId}.founderping-startup"
            android:exported="false" />
    </application>

</manifest>
